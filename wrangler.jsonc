{
  // SPA + Worker: Vite dist/ as static assets, worker.js proxies /api/dmhy/*
  // so the browser can fetch dmhy.org torrents without CORS issues.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crdt-drive",
  "main": "worker.js",
  "compatibility_date": "2026-06-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
